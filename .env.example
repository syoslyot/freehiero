# Copy to .env and fill in values

# FB group URL (required)
FB_GROUP_URL=https://www.facebook.com/groups/YOUR_GROUP_ID/

# Poll interval (seconds, random between min and max)
POLL_MIN_SEC=480
POLL_MAX_SEC=1080

# How many latest posts to check per poll
POSTS_TO_CHECK=10

# Enabled notifiers: comma-separated ("telegram", "gmail", "line")
ENABLED_NOTIFIERS=telegram

# ── Telegram ──────────────────────────────────────────────────────────────────
# Get bot token from @BotFather, chat_id from @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Gmail ─────────────────────────────────────────────────────────────────────
# Generate app password at myaccount.google.com/apppasswords
GMAIL_SENDER=
GMAIL_APP_PASSWORD=
GMAIL_RECIPIENT=

# ── LINE Messaging API ────────────────────────────────────────────────────────
# Channel access token from LINE Developers console
LINE_CHANNEL_ACCESS_TOKEN=
# Your LINE user ID (get via webhook or LINE Developers)
LINE_USER_ID=

# ── Ollama (optional Layer 2 detector) ───────────────────────────────────────
OLLAMA_ENABLED=false
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:0.5b
